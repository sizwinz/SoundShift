{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundShift",
  "version": "0.1.0",
  "identifier": "com.soundshift.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SoundShift",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
